{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(?<slug>[^/]+)$",
      "dest": "/$slug/index.html"
    },
    {
      "src": "/category/(?<category>[^/]+)$",
      "dest": "/category/$category/index.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
