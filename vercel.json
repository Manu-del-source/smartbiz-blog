{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/category/:category",
      "destination": "/category/:category/index.html"
    },
    {
      "source": "/:slug",
      "destination": "/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
